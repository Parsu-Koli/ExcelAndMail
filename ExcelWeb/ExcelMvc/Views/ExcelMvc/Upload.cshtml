@{
    ViewData["Title"] = "Upload Excel";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4 class="mt-1 mb-1">Upload Excel File</h4>
                </div>

                <div class="card-body">

                    <form method="post" enctype="multipart/form-data">
                        <label class="form-label">Select Excel (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" />

                        <button class="btn btn-primary w-100 mt-3">Upload</button>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 text-center">
                            @ViewBag.Error
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
